{
  "schema_version": 1,
  "skill": "drive-writeback",
  "delivery": "drive_writeback_with_local_receipt",
  "local_artifact_contract": {
    "directory": "mars-research",
    "format": "markdown",
    "unique_name_required": true,
    "overwrite": "forbidden"
  },
  "explicit_confirmation_required": true,
  "supported_operations": [
    "initialize_workbench",
    "workbench_write"
  ],
  "initialization_contract": {
    "root_name": "投研工作台",
    "root_scope": "my_drive",
    "root_mime_type": "application/vnd.google-apps.folder",
    "idempotent": true,
    "stateless_drive_id_resolution": true,
    "exact_name_and_parent_resolution": true,
    "duplicate_roots_require_user_selection": true,
    "readback_verification_required": true,
    "readback_fields": [
      "id",
      "name",
      "mime_type",
      "parent_id"
    ],
    "result_statuses": [
      "created",
      "existing",
      "failed",
      "pending"
    ],
    "forbidden_mutations": [
      "move",
      "overwrite",
      "rename",
      "delete"
    ],
    "precreate_case_documents": false
  },
  "response_fields": [
    "proposal_id",
    "proposed_target",
    "base_revision",
    "confirmation_status",
    "write_result",
    "local_artifact"
  ],
  "forbidden_effects": [
    "research",
    "market_data",
    "account_access",
    "broker_write",
    "trade_execution"
  ],
  "scenarios": [
    {
      "request": "初始化我的投研工作台。",
      "expected": {
        "proposal_id": "included",
        "proposed_target": "included",
        "confirmation_status": "pending",
        "write_result": "not_executed",
        "local_artifact": "markdown_created"
      }
    },
    {
      "request": "把这个交易想法写入该案例的工作台主文档。",
      "expected": {
        "proposal_id": "included",
        "proposed_target": "idea_log",
        "base_revision": "included",
        "confirmation_status": "pending",
        "write_result": "not_executed",
        "local_artifact": "markdown_created"
      }
    },
    {
      "request": "确认将已确定方案的新 revision 写入工作台。",
      "expected": {
        "proposal_id": "echoed",
        "proposed_target": "current_plan",
        "base_revision": "rechecked",
        "confirmation_status": "confirmed",
        "write_result": "written_and_verified",
        "local_artifact": "markdown_created"
      }
    }
  ],
  "workbench_contract": {
    "master_doc_per_case": true,
    "sections": [
      "idea_log",
      "current_plan",
      "decision_log",
      "review_log"
    ],
    "plan_versioning": "stable_plan_id_incrementing_revision",
    "conflict": "explicit_user_choice_keep_merge_or_new_plan",
    "outbox": "visible_local_pending_sync_recheck_parent_revision",
    "full_research_copy_to_drive": "forbidden",
    "full_research_reference": "artifact_id_or_link_only",
    "local_simulation_script": "scripts/drive_workbench.py",
    "real_drive_write_requires_explicit_confirmation": true,
    "initialization_confirmation_separate_from_write": true,
    "user_sections_preserved": true
  }
}
