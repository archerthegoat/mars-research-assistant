{
  "schema_version": 1,
  "skill": "ask-mars",
  "delivery": "local_markdown_recommendation",
  "local_artifact_contract": {
    "directory": "mars-research",
    "format": "markdown",
    "unique_name_required": true,
    "overwrite": "forbidden"
  },
  "market_scope_guidance": {
    "preference_file": "mars-market-preferences.json",
    "unset_behavior": "recommend_market_onboarding_multi_select",
    "no_default_us": true,
    "user_timezone_does_not_select_market": true,
    "explicit_market_overrides": true
  },
  "response_fields": [
    "recommended_skills",
    "first_step",
    "minimum_input",
    "assumptions",
    "quick_replies",
    "local_artifact"
  ],
  "forbidden_effects": [
    "research",
    "market_data",
    "drive_write"
  ],
  "scenarios": [
    {
      "request": "帮我准备下周美股事件，并研究 NVDA。",
      "expected": {
        "recommended_skills": [
          "市场催化剂简报",
          "个股快览"
        ],
        "sequence": [
          "市场催化剂简报",
          "个股快览"
        ],
        "first_step": "市场催化剂简报",
        "minimum_input": [],
        "assumptions": {
          "catalyst_window": "next week",
          "market_scope": "preference_or_explicit"
        },
        "quick_replies": [
          "开始市场催化剂简报",
          "调整研究范围"
        ],
        "local_artifact": "markdown_created"
      }
    },
    {
      "request": "分析 NVDA 日线趋势、关键位并给我一张可审计图表。",
      "expected": {
        "recommended_skills": [
          "技术面分析"
        ],
        "first_step": "技术面分析",
        "minimum_input": [
          "新的 output_dir"
        ],
        "assumptions": {
          "timeframe": "1D",
          "market_scope": "preference_or_explicit"
        },
        "quick_replies": [
          "提供 output_dir",
          "先看市场快照"
        ],
        "local_artifact": "markdown_created"
      }
    },
    {
      "request": "/ask mars",
      "expected": {
        "recommended_skills": [
          "市场快照",
          "市场催化剂简报"
        ],
        "sequence": [
          "市场快照",
          "市场催化剂简报"
        ],
        "first_step": "市场快照",
        "minimum_input": [],
        "assumptions": {
          "catalyst_window": "next 7 calendar days",
          "market_scope": "preference_or_explicit"
        },
        "quick_replies": [
          "开始",
          "只看市场快照",
          "添加 ticker"
        ],
        "local_artifact": "markdown_created"
      }
    },
    {
      "request": "开始今天的交易研究",
      "expected": {
        "recommended_skills": [
          "市场快照",
          "市场催化剂简报"
        ],
        "sequence": [
          "市场快照",
          "市场催化剂简报"
        ],
        "first_step": "市场快照",
        "minimum_input": [],
        "assumptions": {
          "catalyst_window": "next 7 calendar days",
          "market_scope": "preference_or_explicit"
        },
        "quick_replies": [
          "开始",
          "只看市场快照",
          "添加 ticker"
        ],
        "local_artifact": "markdown_created"
      }
    },
    {
      "request": "基于上周的深度研究 artifact，讨论一下新公告对方案的影响。",
      "expected": {
        "recommended_skills": [
          "投研分析"
        ],
        "first_step": "投研分析",
        "minimum_input": [
          "本地 artifact 路径、Drive 文档 ID 或 case_id"
        ],
        "assumptions": {
          "incremental_only": true,
          "auto_invoke_deep_research": false
        },
        "quick_replies": [
          "提供 artifact 路径",
          "提供 case_id"
        ],
        "local_artifact": "markdown_created"
      }
    }
  ]
}
